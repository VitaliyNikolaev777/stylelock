  {
    "name": "generate",
    "description": "Generate n images (max 4) through the style lock. `subject` is what to depict, never how it looks; per-image direction goes in `extra`. Provider and model are fixed by the host. Returns a summary per image plus a preview of each.",
    "input_schema": {
      "type": "object",
      "properties": {
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        },
        "variant": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant"
        },
        "character": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Character"
        },
        "extra": {
          "default": "",
          "title": "Extra",
          "type": "string"
        },
        "n": {
          "default": 1,
          "title": "N",
          "type": "integer"
        },
        "style_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Style Version"
        },
        "roles": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Roles"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tags"
        },
        "ref_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref Ids"
        },
        "allow_draft": {
          "default": false,
          "title": "Allow Draft",
          "type": "boolean"
