      "type": "object",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "max_side": {
          "default": 1024,
          "title": "Max Side",
          "type": "integer"
        },
        "checker": {
          "default": true,
          "title": "Checker",
          "type": "boolean"
        }
      },
      "required": [
        "path"
      ],
      "title": "view_imageArguments"
    }
  },
