            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Options"
        },
        "preview_size": {
          "default": 512,
          "title": "Preview Size",
          "type": "integer"
        }
      },
      "required": [
        "subject"
      ],
      "title": "generateArguments"
    }
  },
  {
    "name": "view_image",
    "description": "Show an image from the project at up to max_side pixels. Transparent images are drawn over a checkerboard unless checker=false.",
